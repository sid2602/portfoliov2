---
import BenefitsV1 from "../components/BenefitsV1.astro";
import Benefits2 from "../components/Benefits2.astro";
import Hero from "../components/Hero.astro";
import Layout from "../layouts/Layout.astro";
import CaseStudy from "../components/CaseStudy.astro";
import Offer from "../components/Offer.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import Faq from "../components/Faq.astro";
import Process from "../components/Process.astro";
import { buildFaqPageSchema } from "../config/faq";

const pageUrl = Astro.site
	? new URL(import.meta.env.BASE_URL, Astro.site).toString()
	: Astro.url.href;
const faqPageSchema = buildFaqPageSchema(pageUrl);
---

<Layout jsonLd={[faqPageSchema]}>
	<Hero />
	<div class="bg-background pb-12 sm:pb-16">
		<BenefitsV1 />
	</div>
	<Benefits2 />
	<Offer />
	<Process />
	<CaseStudy />
	<Experience />
	<Contact />
	<Faq />
</Layout>

<script>
	import { initSectionTracking } from "../scripts/analytics";

	initSectionTracking();
</script>
