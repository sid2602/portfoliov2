---
import Footer from '../components/Footer.astro';
import Nav from '../components/Nav.astro';
import { buildPersonProviderRef, buildPersonSchema, personJobTitle } from '../config/person';
import { contactEmail, siteName } from '../config/site';
import '../styles/global.css';

type Props = {
	title?: string;
	description?: string;
	/** Path under `public/` (or BASE_URL) e.g. `/og.png` */
	ogImagePath?: string;
	/**
	 * When true, instruct search engines not to index/follow.
	 * Keep true for testing/staging; flip to false for production indexing.
	 */
	noindex?: boolean;
	/** Optional extra JSON-LD objects rendered in `<head>` */
	jsonLd?: Record<string, unknown>[];
};

const {
	title = `${siteName} — ${personJobTitle}`,
	description = 'Strona, która sprzedaje: projektuję, piszę i wdrażam witryny oraz aplikacje webowe. Zamieniam odwiedziny w zapytania: jasny przekaz, UX i szybkie wdrożenie pod pozyskiwanie klientów.',
	ogImagePath = `${import.meta.env.BASE_URL}hero.webp`,
	noindex = false,
	jsonLd = [],
} = Astro.props satisfies Props;

const canonicalUrl = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const ogImageUrl = Astro.site ? new URL(ogImagePath, Astro.site) : new URL(ogImagePath, Astro.url);
const siteUrl = Astro.site
	? new URL(import.meta.env.BASE_URL, Astro.site).toString()
	: canonicalUrl.origin;

const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const umamiScriptUrl = import.meta.env.PUBLIC_UMAMI_SCRIPT_URL;
const umamiEnabled =
	typeof umamiWebsiteId === 'string' &&
	umamiWebsiteId.length > 0 &&
	typeof umamiScriptUrl === 'string' &&
	umamiScriptUrl.length > 0;

const jsonLdWebsite = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	name: siteName,
	url: siteUrl,
	inLanguage: 'pl-PL',
};

const jsonLdPerson = buildPersonSchema({
	pageUrl: siteUrl,
	imageUrl: ogImageUrl.toString(),
	description,
});

const jsonLdService = {
	'@context': 'https://schema.org',
	'@type': 'ProfessionalService',
	name: 'Filip Kornaus — strony i aplikacje',
	url: siteUrl,
	description,
	areaServed: ['PL', 'EU', 'Worldwide'],
	serviceType: ['Strony www', 'Landing page', 'Wdrożenia', 'Aplikacje webowe'],
	contactPoint: [
		{
			'@type': 'ContactPoint',
			contactType: 'sales',
			email: contactEmail,
			availableLanguage: ['pl'],
		},
	],
	provider: buildPersonProviderRef(siteUrl),
};
---

<!doctype html>
<html lang="pl" data-theme="light">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
		<link rel="icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<link rel="canonical" href={canonicalUrl.toString()} />
		<meta name="description" content={description} />

		{noindex ? <meta name="robots" content="noindex, nofollow" /> : null}

		<meta property="og:type" content="website" />
		<meta property="og:locale" content="pl_PL" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonicalUrl.toString()} />
		<meta property="og:image" content={ogImageUrl.toString()} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageUrl.toString()} />

		<title>{title}</title>

		<script type="application/ld+json" set:html={JSON.stringify(jsonLdWebsite)} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLdPerson)} />
		<script type="application/ld+json" set:html={JSON.stringify(jsonLdService)} />
		{jsonLd.map((item) => (
			<script type="application/ld+json" set:html={JSON.stringify(item)} />
		))}

		{
			umamiEnabled ? (
				<script
					defer
					src={umamiScriptUrl}
					data-website-id={umamiWebsiteId}
					data-auto-track="true"
					data-performance="true"
				/>
			) : null
		}
	</head>
	<body class="pt-16">
		<Nav />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		min-height: 100%;
		overflow-x: clip;
		font-family: Inter, system-ui, sans-serif;
	}
</style>
