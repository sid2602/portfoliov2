---
import { Icon } from "astro-icon/components";

const homeHref = import.meta.env.BASE_URL;

const links = [
	{ label: "Korzyści", href: "#benefits" },
	{ label: "Oferta", href: "#services" },
	{ label: "Proces", href: "#process" },
	{ label: "Realizacje", href: "#work" },
	{ label: "Doświadczenie", href: "#experience" },
] as const;
---

<header
	class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
	data-nav
>
	<div
		class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-5 sm:px-8 xl:max-w-[1320px]"
	>
		<a
			href={homeHref}
			class="flex shrink-0 items-center gap-1 font-[Montserrat,system-ui,sans-serif] text-lg font-extrabold tracking-tight text-black sm:text-xl"
		>
			<span>Filip</span>
			<span class="text-primary">Kornaus</span>
		</a>

		<nav
			class="hidden items-center gap-1 lg:flex"
			aria-label="Main"
			data-nav-desktop
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						class="rounded-lg px-3 py-2 text-base font-medium text-black/55 transition-colors hover:bg-background-secondary hover:text-primary"
						data-nav-link={link.href.slice(1)}
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-2 sm:gap-3">
			<a
				href="#contact"
				class="hidden rounded-lg bg-[#0f172a] px-5 py-2.5 text-base font-bold text-white shadow-[0_4px_7px_rgba(15,23,42,0.25)] transition-opacity hover:opacity-90 sm:inline-flex"
				data-nav-link="contact"
			>
				Umów rozmowę
			</a>

			<button
				type="button"
				class="inline-flex h-10 w-10 items-center justify-center rounded-lg border border-black/10 text-black transition-colors hover:border-primary/30 hover:bg-background-secondary hover:text-primary lg:hidden"
				aria-expanded="false"
				aria-controls="nav-mobile-menu"
				aria-label="Otwórz menu"
				data-nav-toggle
			>
				<Icon
					name="lucide:menu"
					class="h-5 w-5"
					data-nav-icon-menu
					aria-hidden="true"
				/>
				<Icon
					name="lucide:x"
					class="hidden h-5 w-5"
					data-nav-icon-close
					aria-hidden="true"
				/>
			</button>
		</div>
	</div>

	<div
		id="nav-mobile-menu"
		class="grid overflow-hidden border-t border-black/[0.06] bg-background/95 backdrop-blur-md transition-[grid-template-rows] duration-300 ease-out lg:hidden"
		style="grid-template-rows: 0fr"
		data-nav-menu
		hidden
	>
		<nav
			class="min-h-0 overflow-hidden px-5 pb-5 pt-2 sm:px-8"
			aria-label="Mobile"
		>
			<ul class="flex flex-col gap-1">
				{
					links.map((link) => (
						<li>
							<a
								href={link.href}
								class="block rounded-lg px-3 py-3 text-base font-medium text-black/55 transition-colors hover:bg-background-secondary hover:text-primary"
								data-nav-link={link.href.slice(1)}
							>
								{link.label}
							</a>
						</li>
					))
				}
				<li class="pt-2">
					<a
						href="#contact"
						class="inline-flex w-full justify-center rounded-lg bg-[#0f172a] px-5 py-3 text-base font-bold text-white shadow-[0_4px_7px_rgba(15,23,42,0.25)] transition-opacity hover:opacity-90"
						data-nav-link="contact"
					>
						Umów rozmowę
					</a>
				</li>
			</ul>
		</nav>
	</div>
</header>

<script>
	import { initNav } from "../scripts/nav";

	initNav();
</script>

<style>
	[data-nav][data-nav-scrolled] {
		border-color: rgb(0 0 0 / 0.06);
		background-color: rgb(255 255 255 / 0.92);
		box-shadow: 0 4px 24px rgb(0 81 213 / 0.06);
		backdrop-filter: blur(12px);
	}

	[data-nav]:not([data-nav-scrolled]) {
		background-color: rgb(255 255 255 / 0.72);
		backdrop-filter: blur(8px);
	}

	[data-nav-link][data-nav-active] {
		color: var(--color-primary);
		font-weight: 600;
		background-color: var(--color-background-secondary);
	}
</style>
