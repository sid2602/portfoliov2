---
import { Icon } from "astro-icon/components";

const highlights = [
	"Opisz firmę, branżę i efekt, jaki ma dać strona",
	"Odpowiadam zwykle w ciągu jednego dnia roboczego",
	"Po wiadomości umawiamy krótką, darmową rozmowę bez zobowiązań",
] as const;
---

<section
	id="contact"
	class="scroll-mt-20 bg-background-secondary py-12 sm:py-16 lg:py-20"
	aria-labelledby="contact-heading"
	data-contact
>
	<div
		class="mx-auto max-w-7xl px-5 sm:px-8 xl:max-w-[1320px]"
		data-contact-content
	>
		<div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-12 xl:gap-16">
			<div class="flex flex-col gap-5 sm:gap-6">
				<div>
					<h2
						id="contact-heading"
						class="font-[Montserrat,system-ui,sans-serif] text-3xl text-black sm:text-4xl lg:text-5xl"
					>
						<span data-contact-line>Porozmawiajmy o</span>
						<span data-contact-line class="block text-primary"
							>Twojej stronie</span
						>
					</h2>

					<p
						class="mt-4 text-xl text-black/55 lg:text-2xl"
						data-contact-lead
					>
						Chcesz witrynę, która zbiera zapytania? Napisz kilka słów o firmie,
						a ustalimy zakres, termin i kolejne kroki.
					</p>
				</div>

				<p class="text-black/55" data-contact-body>
					Im więcej napiszesz o biznesie, klientach i oczekiwaniach, tym szybciej
					przygotuję konkretną propozycję. Bez zobowiązań i bez sztywnego
					formularza ofertowego.
				</p>

				<ul class="flex flex-col gap-3" data-contact-highlights>
					{
						highlights.map((text) => (
							<li class="flex items-start gap-3">
								<Icon
									name="lucide:check"
									class="mt-0.5 h-4 w-4 shrink-0 text-primary"
									aria-hidden="true"
								/>
								<p class="text-black/55">{text}</p>
							</li>
						))
					}
				</ul>
			</div>

			<div
				class="rounded-2xl bg-background p-6 shadow-[0_4px_20px_rgba(0,81,213,0.08),0_2px_6px_rgba(15,23,42,0.04)] sm:p-8"
				data-contact-form-wrap
			>
				<form
					class="flex flex-col gap-5"
					data-contact-form
					novalidate
				>
					<div class="grid gap-5 sm:grid-cols-2">
						<div class="flex flex-col gap-2">
							<label
								for="contact-name"
								class="text-base font-semibold text-black"
							>
								Imię
							</label>
							<input
								id="contact-name"
								name="name"
								type="text"
								autocomplete="name"
								required
								placeholder="Twoje imię"
								class="rounded-lg border border-black/10 bg-background px-4 py-3 text-base text-black outline-none transition-[border-color,box-shadow] placeholder:text-black/35 focus:border-primary focus:ring-2 focus:ring-primary/20"
							/>
						</div>

						<div class="flex flex-col gap-2">
							<label
								for="contact-email"
								class="text-base font-semibold text-black"
							>
								Email
							</label>
							<input
								id="contact-email"
								name="email"
								type="email"
								autocomplete="email"
								required
								placeholder="ty@firma.pl"
								class="rounded-lg border border-black/10 bg-background px-4 py-3 text-base text-black outline-none transition-[border-color,box-shadow] placeholder:text-black/35 focus:border-primary focus:ring-2 focus:ring-primary/20"
							/>
						</div>
					</div>

					<div class="flex flex-col gap-2">
						<label
							for="contact-company"
							class="text-base font-semibold text-black"
						>
							Firma
							<span class="font-normal text-black/45"
								>(opcjonalnie)</span
							>
						</label>
						<input
							id="contact-company"
							name="company"
							type="text"
							autocomplete="organization"
							placeholder="Nazwa firmy lub projektu"
							class="rounded-lg border border-black/10 bg-background px-4 py-3 text-base text-black outline-none transition-[border-color,box-shadow] placeholder:text-black/35 focus:border-primary focus:ring-2 focus:ring-primary/20"
						/>
					</div>

					<div class="flex flex-col gap-2">
						<label
							for="contact-message"
							class="text-base font-semibold text-black"
						>
							Wiadomość
						</label>
						<textarea
							id="contact-message"
							name="message"
							required
							rows="5"
							placeholder="Np. czym się zajmujesz, jaki efekt chcesz osiągnąć i kiedy chcesz wystartować…"
							class="min-h-[140px] resize-y rounded-lg border border-black/10 bg-background px-4 py-3 text-base text-black outline-none transition-[border-color,box-shadow] placeholder:text-black/35 focus:border-primary focus:ring-2 focus:ring-primary/20"
						></textarea>
					</div>

					<button
						type="submit"
						class="inline-flex w-full justify-center rounded-lg bg-[#0f172a] px-8 py-4 text-base font-bold text-white shadow-[0_4px_7px_rgba(15,23,42,0.39)] transition-opacity hover:opacity-90 sm:w-auto sm:self-start"
					>
						Wyślij wiadomość
					</button>

					<p
						class="hidden text-base text-primary"
						role="status"
						aria-live="polite"
						data-contact-success
					>
						Dziękuję! Twoja wiadomość jest gotowa do wysłania.
					</p>
				</form>
			</div>
		</div>
	</div>
</section>

<script>
	import { initContactAnimations } from "../scripts/contact-animations";
	import { initContactForm } from "../scripts/contact-form";

	const contact = document.querySelector("[data-contact]");

	if (contact instanceof HTMLElement) {
		initContactAnimations(contact);
		initContactForm(contact);
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-contact] [data-contact-line],
		[data-contact] [data-contact-lead],
		[data-contact] [data-contact-body],
		[data-contact] [data-contact-highlights],
		[data-contact] [data-contact-form-wrap] {
			opacity: 0;
		}
	}
</style>
