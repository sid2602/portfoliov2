---
const steps = [
	{
		number: "01",
		label: "Poznanie",
		title: "Najpierw Twój klient, potem projekt",
		description:
			"Rozmawiamy o biznesie, ofercie i tym, kogo chcesz przyciągnąć na stronę. Ustalamy, co odwiedzający musi zobaczyć i usłyszeć, żeby się odezwać. To fundament całego projektu, bez szablonów i bez zgadywania.",
	},
	{
		number: "02",
		label: "Strategia",
		title: "Plan, zanim ruszy projekt",
		description:
			"Na tej podstawie układam strukturę strony, kluczowe przekazy i miejsca na kontakt. Wiesz, co powstanie i dlaczego, zanim zobaczysz pierwszą wersję wizualną.",
	},
	{
		number: "03",
		label: "Projekt",
		title: "Projekt i dopracowanie strony",
		description:
			"Projektuję i koduję witrynę tak, by prowadziła do telefonu, formularza lub rezerwacji. Po każdej prezentacji wersji zbierasz uwagi i przesyłasz je jednorazowo. W ramach współpracy przewiduję maksymalnie 2 rundy takich zbiorczych poprawek, żeby wprowadzać zmiany sprawnie i trzymać uzgodniony termin.",
	},
	{
		number: "04",
		label: "Wdrożenie",
		title: "Start z działającym narzędziem",
		description:
			"Publikuję stronę, konfiguruję SEO i analitykę. Od pierwszego dnia widzisz ruch i wiesz, ile osób przechodzi do kontaktu z Twoją firmą.",
	},
] as const;
---

<section
	id="process"
	class="relative scroll-mt-20 overflow-hidden bg-background py-12 sm:py-16 lg:py-20"
	aria-labelledby="process-heading"
	data-process
>
	<img
		src="/background-grid2.svg"
		alt=""
		class="pointer-events-none absolute inset-0 h-full w-full object-cover object-center"
		width="1512"
		height="982"
		loading="lazy"
		decoding="async"
		aria-hidden="true"
	/>

	<div
		class="relative mx-auto max-w-7xl px-5 sm:px-8 xl:max-w-[1320px]"
		data-process-content
	>
		<header class="mx-auto max-w-3xl text-center">
			<h2
				id="process-heading"
				class="font-[Montserrat,system-ui,sans-serif] text-3xl text-black sm:text-4xl lg:text-5xl"
			>
				<span data-process-line>Jak wygląda</span>
				<span data-process-line class="text-primary">
					współpraca ze mną</span
				>
			</h2>
		</header>

		<ol class="mt-10 flex flex-col items-center sm:mt-12">
			{
				steps.map((step, index) => (
					<li
						class:list={[
							"w-full max-w-5xl border-primary/15 lg:max-w-6xl xl:max-w-7xl",
							index > 0 && "border-t",
						]}
						data-process-step
					>
						<div class="mx-auto grid w-full max-w-5xl grid-cols-1 gap-5 py-8 sm:py-10 lg:w-fit lg:max-w-none lg:grid-cols-[11.25rem_1px_36rem] lg:items-center lg:gap-x-8 lg:gap-y-0 xl:grid-cols-[11.25rem_1px_42rem]">
							<div class="flex w-full flex-col gap-2 text-left lg:w-[11.25rem] lg:items-center lg:justify-center lg:text-center">
								<span
									class="font-[Montserrat,system-ui,sans-serif] text-5xl leading-none font-bold text-icon sm:text-6xl"
									aria-hidden="true"
								>
									{step.number}
								</span>
								<span class="text-xl font-bold text-black sm:text-2xl">
									{step.label}
								</span>
							</div>

							<div
								class="hidden w-px bg-primary/15 lg:block lg:min-h-full"
								aria-hidden="true"
							/>

							<div class="flex w-full max-w-xl flex-col gap-2 text-left lg:w-[36rem] lg:max-w-none xl:w-[42rem]">
								<h3 class="text-3xl font-bold text-black/70">
									{step.title}
								</h3>
								<p class="text-black/55">{step.description}</p>
							</div>
						</div>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	import { initProcessAnimations } from "../scripts/process-animations";

	const process = document.querySelector("[data-process]");

	if (process instanceof HTMLElement) {
		initProcessAnimations(process);
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-process] [data-process-line],
		[data-process] [data-process-step] {
			opacity: 0;
		}
	}
</style>
