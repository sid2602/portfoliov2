---
import { Icon } from "astro-icon/components";
import heroGridSvg from "../../public/background-grid.svg?raw";

const stats = [
	{
		value: "200%",
		label: "więcej zapytań",
		icon: "lucide:chart-column",
	},
	{
		value: "97%",
		label: "klientów szuka Cię online",
		icon: "lucide:users",
	},
] as const;

const assetBase = import.meta.env.BASE_URL;

const heroGridMarkup = heroGridSvg.replace(
	"<svg ",
	'<svg class="pointer-events-none absolute inset-0 h-full w-full" aria-hidden="true" preserveAspectRatio="xMinYMin slice" ',
);
---

<section
	id="hero"
	class="relative overflow-visible bg-background-secondary pt-6 pb-6 sm:pt-16 sm:pb-8 lg:flex lg:min-h-[calc(100dvh-4rem)] lg:flex-col lg:justify-start lg:pt-10 lg:pb-12"
	aria-labelledby="hero-heading"
	role="region"
	data-hero
>
	<div class="contents" set:html={heroGridMarkup} />

	<div
		class="relative mx-auto flex max-w-7xl flex-col gap-8 px-5 sm:gap-12 sm:px-8 lg:flex-row lg:items-center lg:gap-10 xl:max-w-[1320px]"
	>
		<div class="flex max-w-[689px] flex-1 flex-col gap-4 sm:gap-6">
			<h1
				id="hero-heading"
				class="font-[Montserrat,system-ui,sans-serif] text-4xl text-black sm:text-5xl lg:text-6xl"
			>
				<span data-hero-line class="block lg:whitespace-nowrap"
					>Twoja firma zasługuje</span
				>
				<span data-hero-line class="block lg:whitespace-nowrap"
					>na stronę, która</span
				>
				<span
					data-hero-line
					class="block text-primary lg:whitespace-nowrap"
					>pracuje na wynik</span
				>
			</h1>

			<p
				class="max-w-[650px] text-black/80 text-xl lg:text-2xl"
				data-hero-intro
			>
				Powiedz mi, czym się zajmujesz. Ja zajmę się resztą, od projektu
				po uruchomienie. Ty dostajesz <strong
					>gotową witrynę, która pozyskuje klientów</strong
				>
			</p>

			<div class="flex flex-col gap-4 pt-2 sm:flex-row sm:flex-wrap">
				<div data-hero-cta-wrap>
					<a
						href="#contact"
						class="inline-flex cursor-pointer justify-center rounded-lg bg-[#0f172a] px-8 py-4 text-base font-bold leading-normal text-white shadow-[0_4px_7px_rgba(15,23,42,0.39)] transition-opacity hover:opacity-90"
					>
						Umów darmową rozmowę
					</a>
				</div>
				<div data-hero-cta-wrap>
					<a
						href="#process"
						class="inline-flex cursor-pointer justify-center rounded-lg border border-[#c6c6cd] px-8 py-4 text-base font-semibold leading-normal text-[#191c1e] shadow-sm transition-colors hover:bg-background/60"
					>
						Zobacz, jak pracuję
					</a>
				</div>
			</div>
		</div>

		<div
			class="relative mx-auto flex w-full max-w-[280px] flex-1 flex-col items-center sm:max-w-md lg:mx-0 lg:max-w-lg pb-8"
		>
			<img
				src={`${assetBase}background-effect2.svg`}
				alt=""
				class="pointer-events-none absolute bottom-12 right-0 z-0 w-24 sm:bottom-20 sm:w-32 lg:bottom-32 lg:w-40"
				width="226"
				height="226"
				loading="lazy"
				aria-hidden="true"
				data-hero-effect
			/>
			<img
				src={`${assetBase}background-effect1.svg`}
				alt=""
				class="pointer-events-none absolute right-0 top-0 z-0 w-28 opacity-90 sm:right-1/4 sm:w-40 lg:right-[12%] lg:w-48"
				width="290"
				height="257"
				loading="lazy"
				aria-hidden="true"
				data-hero-effect
			/>

			<img
				src={`${assetBase}3.webp`}
				alt="Filip — zdjęcie w sekcji hero"
				class="relative z-10 mx-auto h-auto w-full max-w-[240px] object-contain sm:max-w-[300px] md:max-w-[360px] lg:max-w-[433px] lg:max-h-[576px]"
				width="433"
				height="576"
				loading="eager"
				fetchpriority="high"
				decoding="async"
				data-hero-portrait
			/>

			<div
				class="relative z-20 -mt-10 flex justify-center gap-1 sm:-mt-14 sm:gap-2 lg:-mt-20"
			>
				{
					stats.map((stat) => (
						<article
							data-hero-stat
							class="grid h-[118px] w-[118px] grid-rows-[1fr_auto_1fr] justify-items-center gap-y-1 rounded-xl bg-background p-2 shadow-[0_8px_30px] shadow-primary/8 sm:h-[142px] sm:w-[142px] sm:gap-y-2 md:size-[188px] md:gap-y-3 lg:size-[140px] xl:size-[196px] lg:gap-y-2 xl:gap-y-4"
						>
							<Icon
								name={stat.icon}
								class="row-start-1 size-6 shrink-0 self-end text-icon sm:size-7 md:size-8"
								aria-hidden="true"
							/>
							<span class="row-start-2 text-center text-xl font-bold leading-none text-black/80 sm:text-2xl md:text-3xl lg:text-2xl xl:text-3xl">
								{stat.value}
							</span>
							<span class="row-start-3 self-start text-center text-xs leading-tight text-black/60 sm:text-sm">
								{stat.label}
							</span>
						</article>
					))
				}
			</div>
		</div>
	</div>
</section>

<script>
	const hero = document.querySelector("[data-hero]");

	const shouldAnimate =
		hero instanceof HTMLElement &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (shouldAnimate) {
		const start = () =>
			import("../scripts/hero-animations").then(
				({ initHeroAnimations }) => {
					initHeroAnimations(hero);
				},
			);

		if (typeof requestIdleCallback === "function") {
			requestIdleCallback(start, { timeout: 2000 });
		} else {
			setTimeout(start, 1);
		}
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-hero] [data-hero-line],
		[data-hero] [data-hero-intro],
		[data-hero] [data-hero-cta-wrap],
		[data-hero] [data-hero-effect],
		[data-hero] [data-hero-stat] {
			opacity: 0;
		}
	}
</style>
