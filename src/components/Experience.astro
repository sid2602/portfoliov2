---
import { Icon } from "astro-icon/components";

const experiences = [
	{
		company: "Medius",
		industry: "KSIĘGOWOŚĆ KORPORACYJNA",
		icon: "lucide:building-2",
		description:
			"Oprogramowanie dla księgowości korporacyjnej: integracja komunikacji z produktami w jednym ekosystemie. Klient widzi spójną ofertę, a zespół mniej przełącza się między rozproszonymi systemami.",
		side: "left",
	},
	{
		company: "Playbook Engineering",
		industry: "ZAKŁADY SPORTOWE ONLINE",
		icon: "lucide:shield-check",
		description:
			"Platforma zakładów sportowych: płatności online i mechanizmy odpowiedzialnej gry, zaprojektowane zgodnie z restrykcyjnymi wymogami regulacyjnymi, gdzie każdy element produktu musi działać niezawodnie.",
		side: "right",
	},
	{
		company: "Futurum Technology",
		industry: "SOFTWARE HOUSE",
		icon: "lucide:rocket",
		description:
			"MVP dla startupów w różnych branżach: działające produkty zamiast koncepcji na slajdach. Na tej podstawie wiele z nich pozyskało wielomilionowe dofinansowanie.",
		side: "left",
	},
] as const;
---

<section
	id="experience"
	class="scroll-mt-20 bg-background py-12 sm:py-16 lg:py-20"
	aria-labelledby="experience-heading"
	data-experience
>
	<div
		class="mx-auto max-w-7xl px-5 sm:px-8 xl:max-w-[1320px]"
		data-experience-content
	>
		<header class="mx-auto max-w-3xl text-center">
			<h2
				id="experience-heading"
				class="font-[Montserrat,system-ui,sans-serif] text-3xl sm:text-4xl lg:text-5xl"
			>
				<span data-experience-line class="text-primary"
					>Doświadczenie</span
				>
				<span data-experience-line class="block text-black"
					>z kilku branż</span
				>
			</h2>

			<p
				class="mt-4 text-base text-black/55 sm:text-lg"
				data-experience-intro
			>
				Korporacja, regulowany sektor online, software house.
				Doświadczenie z tych środowisk przekładam dziś na strony i
				aplikacje dla klientów.
			</p>
		</header>

		<ol
			class="relative mt-12 [--experience-track:2rem] sm:mt-16 md:[--experience-track:0px]"
		>
			<div
				class="pointer-events-none absolute inset-y-0 w-(--experience-track) md:left-1/2 md:w-px md:-translate-x-1/2"
				aria-hidden="true"
			>
				<div
					class="absolute top-0 left-1/2 h-full w-px -translate-x-1/2 bg-black/10"
				>
				</div>
			</div>

			{
				experiences.map((item, index) => (
					<li
						class:list={[
							"relative grid grid-cols-[var(--experience-track)_1fr] gap-x-5 gap-y-3 pb-12 last:pb-0 md:grid-cols-[1fr_auto_1fr] md:items-center md:gap-x-8 md:gap-y-0 md:pb-16",
							index === experiences.length - 1 && "md:pb-0",
						]}
						data-experience-item
					>
						<div class="relative col-start-1 row-start-1 w-(--experience-track) md:col-start-2 md:row-start-1 md:flex md:w-auto md:justify-center">
							<div
								class="absolute top-6 left-1/2 z-10 size-3 -translate-x-1/2 rounded-full bg-black md:relative md:top-auto md:left-auto md:translate-x-0"
								aria-hidden="true"
							/>
						</div>

						<div
							class:list={[
								"col-start-2 row-start-1 md:col-start-1 md:row-start-1",
								item.side === "right" &&
									"md:col-start-3 md:row-start-1",
							]}
						>
							<article class="rounded-2xl bg-background p-5 shadow-[0_4px_20px_rgba(0,81,213,0.08),0_2px_6px_rgba(15,23,42,0.04)] sm:p-6">
								<div class="flex items-center gap-3">
									<div
										class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-icon"
										aria-hidden="true"
									>
										<Icon
											name={item.icon}
											class="h-5 w-5 text-primary"
										/>
									</div>
									<h3 class="text-xl font-bold text-black">
										{item.company}
									</h3>
								</div>
								<p class="mt-3 text-black/55">
									{item.description}
								</p>
								<p
									class="mt-3 font-mono text-xs uppercase tracking-wider text-black/45 sm:text-sm md:hidden"
									data-experience-industry
								>
									{item.industry}
								</p>
							</article>
						</div>

						<p
							class:list={[
								"hidden font-mono text-xs uppercase tracking-wider text-black/45 sm:text-sm",
								"md:col-span-1 md:row-start-1 md:block md:self-center",
								item.side === "left"
									? "md:col-start-3 md:text-left"
									: "md:col-start-1 md:text-right",
							]}
							data-experience-industry-desktop
						>
							{item.industry}
						</p>
					</li>
				))
			}
		</ol>
	</div>
</section>

<script>
	const experience = document.querySelector("[data-experience]");

	const shouldAnimate =
		experience instanceof HTMLElement &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (shouldAnimate) {
		const start = () =>
			import("../scripts/experience-animations").then(
				({ initExperienceAnimations }) => {
					initExperienceAnimations(experience);
				},
			);

		if (typeof requestIdleCallback === "function") {
			requestIdleCallback(start, { timeout: 2000 });
		} else {
			setTimeout(start, 1);
		}
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-experience] [data-experience-line],
		[data-experience] [data-experience-intro],
		[data-experience] [data-experience-item] {
			opacity: 0;
		}
	}
</style>
