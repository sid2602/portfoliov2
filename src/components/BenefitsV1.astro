---
import { Icon } from "astro-icon/components";

const features = [
	{
		icon: "lucide:trending-up",
		title: "Więcej zapytań z tej samej liczby odwiedzin",
		description:
			"Przemyślany układ i treści pod realne obiekcje klientów podnoszą konwersję nawet o 200%. Więcej wizyt zamienia się w telefony i rezerwacje, bez dokładania budżetu na reklamę.",
	},
	{
		icon: "lucide:search",
		title: "Widoczność tam, gdzie szukają",
		description:
			"97% osób szuka firm online. Strona dopasowana do Twojej branży i okolicy sprawia, że znajdują Ciebie, zanim trafią do konkurencji.",
	},
	{
		icon: "lucide:shield-check",
		title: "Zaufanie od pierwszego spojrzenia",
		description:
			"75% osób ocenia wiarygodność firmy po stronie www. Masz około 50 milisekund na dobre pierwsze wrażenie: albo zostają, albo odchodzą.",
	},
] as const;
---

<div
	id="benefits"
	class="relative z-10 -mt-6 scroll-mt-20 sm:-mt-8 lg:-mt-12"
	data-benefits-v1
>
	<div class="mx-auto max-w-7xl px-5 sm:px-8 xl:max-w-[1320px]">
		<div
			class="overflow-hidden rounded-2xl bg-background shadow-[0_4px_20px_rgba(0,81,213,0.08),0_2px_6px_rgba(15,23,42,0.04)] lg:shadow-[0_6px_28px_rgba(0,81,213,0.1),0_2px_8px_rgba(15,23,42,0.05)]"
		>
			<div
				class="hidden h-12 shrink-0 rounded-t-2xl bg-background lg:block"
				aria-hidden="true"
				data-benefits-peek
			>
			</div>

			<section
				aria-labelledby="benefits-heading"
				class="rounded-2xl bg-background px-5 pt-8 pb-8 sm:px-8 sm:pt-9 sm:pb-9 lg:rounded-t-none lg:px-10 lg:pt-0 lg:pb-10"
			>
				<div data-benefits-content>
					<div
						class="flex flex-col gap-5 lg:flex-row lg:items-center lg:justify-between lg:gap-12"
					>
						<h2
							id="benefits-heading"
							class="max-w-md shrink-0 font-[Montserrat,system-ui,sans-serif] text-3xl text-black sm:text-4xl lg:text-5xl"
						>
							<span data-benefits-line>Wykorzystaj pełny</span>
							<span data-benefits-line class="block text-primary"
								>potencjał swojego biznesu</span
							>
						</h2>

						<p
							class="max-w-md text-xl text-black/55 lg:pt-1 lg:text-2xl"
							data-benefits-intro
						>
							Zanim zadzwonią, klienci sprawdzają Cię w sieci.
							Dobra strona to nie koszt wizytówki, lecz narzędzie,
							które <strong
								>buduje zaufanie i prowadzi do kontaktu</strong
							>, bez Twojego stałego nadzoru.
						</p>
					</div>

					<div
						class="mt-8 grid gap-8 md:mt-9 md:grid-cols-3 md:grid-rows-[auto_auto_1fr] md:gap-x-6 md:gap-y-3 lg:mt-10"
					>
						{
							features.map((feature) => (
								<article
									class="grid grid-rows-[auto_auto_1fr] items-start gap-3 md:grid-rows-subgrid md:row-span-3"
									data-benefits-feature
								>
									<Icon
										name={feature.icon}
										class="block size-10 shrink-0 text-icon"
										aria-hidden="true"
									/>
									<h3 class="m-0 text-xl leading-snug font-bold text-black">
										{feature.title}
									</h3>
									<p class="m-0 text-black/55">
										{feature.description}
									</p>
								</article>
							))
						}
					</div>
				</div>
			</section>
		</div>
	</div>
</div>

<script>
	const benefits = document.querySelector("[data-benefits-v1]");

	const shouldAnimate =
		benefits instanceof HTMLElement &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (shouldAnimate) {
		const start = () =>
			import("../scripts/benefits-animations").then(
				({ initBenefitsAnimations }) => {
					initBenefitsAnimations(benefits);
				},
			);

		if (typeof requestIdleCallback === "function") {
			requestIdleCallback(start, { timeout: 2000 });
		} else {
			setTimeout(start, 1);
		}
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-benefits-v1] [data-benefits-content],
		[data-benefits-v1] [data-benefits-line],
		[data-benefits-v1] [data-benefits-intro],
		[data-benefits-v1] [data-benefits-feature] {
			opacity: 0;
		}
	}
</style>
