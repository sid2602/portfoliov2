---
const links = [
	{ label: "Work", href: "#work" },
	{ label: "About", href: "#about" },
	{ label: "Contact", href: "#contact" },
] as const;
---

<header
	class="fixed inset-x-0 top-0 z-50 flex h-16 w-full items-center border-b border-black/[0.06] bg-white"
>
	<div
		class="mx-auto flex h-full w-full max-w-[1320px] items-center justify-between gap-6 px-5 sm:px-8"
	>
		<a
			href="/"
			class="text-base font-semibold tracking-tight text-[#191c1e]"
		>
			FK
		</a>
		<nav
			class="flex items-center gap-6 text-sm font-medium sm:gap-8 sm:text-[15px]"
			aria-label="Main"
		>
			{
				links.map((link) => (
					<a
						href={link.href}
						class="text-[#45464d] transition-colors hover:text-[#191c1e]"
					>
						{link.label}
					</a>
				))
			}
		</nav>
	</div>
</header>
