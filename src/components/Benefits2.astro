---
const bodyText =
	"Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla at velit quis metus imperdiet sagittis sit amet et lacus. Aenean ac est pretium eros feugiat efficitur sed at elit.";
---

<section
	class="bg-background"
	aria-labelledby="split-content-heading"
	data-split-content-v1
>
	<div
		class="mx-auto max-w-7xl px-5 pb-12 sm:px-8 sm:pb-16 xl:max-w-[1320px]"
	>
		<header class="max-w-3xl">
			<h2
				id="split-content-heading"
				class="font-[Montserrat,system-ui,sans-serif] text-3xl text-black sm:text-4xl lg:text-5xl"
			>
				<span>Lorem Ipsum dolor sit amet</span>
				<span class="block text-primary">consectetur</span>
			</h2>

			<p class="mt-4 max-w-2xl text-xl text-black/55 lg:text-2xl">
				Lorem ipsum dolor sit amet, consectetur adipiscing elit. Nulla
				at velit quis metus imperdiet sagittis sit amet et lacus.
			</p>
		</header>

		<div class="mt-8 grid gap-6 sm:mt-10 lg:grid-cols-2 lg:gap-8">
			<div
				class="aspect-[4/3] w-full rounded-2xl bg-[#e4e7ec]"
				role="img"
				aria-label="Image placeholder — content coming soon"
			>
			</div>

			<div
				class="flex aspect-[4/3] w-full items-center rounded-2xl bg-background-secondary px-6 py-8 sm:px-8 lg:px-10"
			>
				<p class="text-black/55">{bodyText}</p>
			</div>
		</div>
	</div>
</section>
