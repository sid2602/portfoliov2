---
import { Icon } from "astro-icon/components";
import { faqItems, statsBlocks } from "../config/faq";

const linkClass =
	"text-primary underline decoration-primary/30 underline-offset-2 transition-colors hover:text-primary/80";
---

<section
	id="faq"
	class="bg-background py-12 sm:py-16 lg:py-20"
	aria-labelledby="faq-heading"
	role="region"
	data-faq
>
	<div class="mx-auto max-w-3xl px-5 sm:px-8 xl:max-w-[1320px]">
		<header class="text-center">
			<h2
				id="faq-heading"
				class="font-[Montserrat,system-ui,sans-serif] text-3xl text-black sm:text-4xl lg:text-5xl"
			>
				Najczęstsze <span class="text-primary">pytania</span>
			</h2>
			<p class="mt-4 text-lg text-black/55">
				Krótko i na temat, zanim umówimy rozmowę.
			</p>
		</header>

		<div class="mt-10 flex flex-col gap-4 sm:mt-12">
			{
				faqItems.map((item, index) => (
					<button
						type="button"
						data-faq-trigger
						aria-expanded="false"
						aria-controls={`faq-panel-${index}`}
						class="group w-full cursor-pointer rounded-2xl border border-black/[0.06] bg-background p-5 text-left shadow-[0_1px_3px_rgba(15,23,42,0.05)] transition-[box-shadow,ring-color,border-color] hover:border-black/10 hover:shadow-[0_2px_6px_rgba(15,23,42,0.07)] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-primary/30 data-[open=true]:border-primary/15 data-[open=true]:ring-2 data-[open=true]:ring-primary/15 sm:p-6"
					>
						<span class="flex items-start justify-between gap-4">
							<span class="text-base font-semibold text-black sm:text-lg">
								{item.question}
							</span>
							<span
								class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-icon text-primary transition-transform duration-300 group-data-[open=true]:rotate-180 motion-reduce:transition-none"
								aria-hidden="true"
							>
								<Icon
									name="lucide:chevron-down"
									class="h-5 w-5"
								/>
							</span>
						</span>

						<span
							id={`faq-panel-${index}`}
							data-faq-panel
							aria-hidden="true"
							inert
							class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out group-data-[open=true]:grid-rows-[1fr] motion-reduce:transition-none"
						>
							<span class="overflow-hidden">
								{item.kind === "stats" ? (
									<span class="block pt-4 text-base leading-relaxed text-black/55 opacity-0 transition-opacity duration-300 ease-out group-data-[open=true]:opacity-100 motion-reduce:transition-none">
										<span class="block">
											Liczby z sekcji korzyści opieram na
											badaniach branżowych i UX. Poniżej
											te same przekazy ze źródłami.
										</span>

										<span class="mt-5 flex flex-col gap-5">
											{statsBlocks.map((block) => (
												<span class="block">
													<span class="block font-semibold text-black">
														{block.title}
													</span>
													<span class="mt-1 block">
														{block.text}
													</span>
													<span class="mt-2 block text-sm">
														Źródło:{" "}
														{block.sources.map(
															(
																source,
																sourceIndex,
															) => (
																<>
																	{sourceIndex >
																		0 && (
																		<span>
																			{" "}
																			·{" "}
																		</span>
																	)}
																	<a
																		href={
																			source.href
																		}
																		class={
																			linkClass
																		}
																		target="_blank"
																		rel="noopener noreferrer"
																	>
																		{
																			source.label
																		}
																	</a>
																</>
															),
														)}
													</span>
												</span>
											))}
										</span>

										<span class="mt-5 block text-sm text-black/45">
											Wynik zależy od branży, ruchu i
											punktu startowego. To kierunek z
											badań, a nie gwarancja identycznego
											efektu w każdym projekcie.
										</span>
									</span>
								) : (
									<span class="block pt-4 text-base leading-relaxed text-black/55 opacity-0 transition-opacity duration-300 ease-out group-data-[open=true]:opacity-100 motion-reduce:transition-none">
										{item.answer}
									</span>
								)}
							</span>
						</span>
					</button>
				))
			}
		</div>
	</div>
</section>

<script>
	import { initFaq } from "../scripts/faq";

	const faq = document.querySelector("[data-faq]");

	if (faq instanceof HTMLElement) {
		initFaq(faq);
	}
</script>
