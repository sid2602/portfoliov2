---
import { Icon } from "astro-icon/components";

const offers = [
	{
		icon: "lucide:code-xml",
		title: "Projekt i kodowanie",
		description:
			"Strona od zera pod Twój biznes i grupę docelową. Szybka, mobilna i gotowa do uruchomienia.",
	},
	{
		icon: "lucide:search",
		title: "Optymalizacja SEO i GEO",
		description:
			"Widoczność w wynikach wyszukiwania i w odpowiedziach z narzędzi AI tam, gdzie ludzie szukają usług jak Twoja, lokalnie i w całej Polsce.",
	},
	{
		icon: "lucide:pen-line",
		title: "Treści sprzedażowe",
		description:
			"Nagłówki, opisy i komunikaty pisane pod Twojego klienta. Jasno tłumaczą ofertę i zachęcają do kontaktu, zamiast brzmieć jak szablon z internetu.",
	},
	{
		icon: "lucide:chart-column",
		title: "Analityka i śledzenie konwersji",
		description:
			"Wiesz, skąd przychodzą leady i które podstrony realnie przynoszą zapytania.",
	},
	{
		icon: "lucide:life-buoy",
		title: "Opieka po wdrożeniu",
		description:
			"Nie znikam po starcie. Aktualizuję, poprawiam i rozwijam stronę wraz z Twoim biznesem.",
	},
	{
		icon: "lucide:route",
		title: "Architektura pod konwersję",
		description:
			"Każdy nagłówek, sekcja i przycisk ma jedno zadanie: skrócić drogę od „przeglądam” do momentu, w którym odwiedzający staje się klientem.",
	},
] as const;
---

<section
	id="services"
	class="bg-offer-bg scroll-mt-20 py-12 sm:py-16 lg:py-20"
	aria-labelledby="offer-heading"
	role="region"
	data-offer
>
	<div
		class="mx-auto max-w-7xl px-5 sm:px-8 xl:max-w-[1320px]"
		data-offer-content
	>
		<div class="grid gap-8 lg:gap-10">
			<div class="flex flex-col">
				<h2
					id="offer-heading"
					class="font-[Montserrat,system-ui,sans-serif] text-3xl text-offer-text sm:text-4xl lg:text-5xl"
					aria-label="Co otrzymujesz w ramach współpracy"
				>
					<span data-offer-line>Co otrzymujesz</span>
					<span data-offer-line class="block text-primary"
						>w ramach współpracy</span
					>
				</h2>

				<p class="mt-4 max-w-xl text-lg text-offer-text-muted">
					Każdy element poniżej ma jeden cel: żeby więcej odwiedzin
					zamieniało się w nowych klientów dla Twojej firmy.
				</p>

				<div class="mt-8 grid gap-4 sm:mt-10 sm:grid-cols-2 sm:gap-5">
					{
						offers.map((item) => (
							<article
								class="flex flex-col gap-3 rounded-2xl border border-offer-surface-border bg-offer-surface p-5 sm:p-6"
								data-offer-item
							>
								<div
									class="flex h-10 w-10 items-center justify-center rounded-full bg-offer-icon-bg"
									aria-hidden="true"
								>
									<Icon
										name={item.icon}
										class="h-5 w-5 text-icon"
									/>
								</div>
								<h3 class="text-xl font-bold text-offer-text">
									{item.title}
								</h3>
								<p class="text-offer-text-muted">
									{item.description}
								</p>
							</article>
						))
					}
				</div>
			</div>
		</div>
	</div>
</section>

<script>
	const offer = document.querySelector("[data-offer]");

	const shouldAnimate =
		offer instanceof HTMLElement &&
		!window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	if (shouldAnimate) {
		const start = () =>
			import("../scripts/offer-animations").then(({ initOfferAnimations }) => {
				initOfferAnimations(offer);
			});

		if (typeof requestIdleCallback === "function") {
			requestIdleCallback(start, { timeout: 2000 });
		} else {
			setTimeout(start, 1);
		}
	}
</script>

<style>
	@media (prefers-reduced-motion: no-preference) {
		[data-offer] [data-offer-line],
		[data-offer] [data-offer-item],
		[data-offer] [data-offer-media] {
			opacity: 0;
		}
	}
</style>
